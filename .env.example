# .env.example — variables de entorno para el despliegue de api/ (Stage 10).
# Copiar a .env para desarrollo local; en Railway, configurar cada una
# como variable de entorno del servicio (no subir un .env real a git).

# Orígenes permitidos para CORS, separados por coma. Sin esta variable,
# CORS queda deshabilitado (uso interno / mismo dominio / tests).
# Ejemplo para el frontend Next.js en Vercel + un entorno de preview:
ALLOWED_ORIGINS=https://lattise.io,https://www.lattise.io

# Puerto en el que escucha gunicorn/Flask. Railway lo inyecta solo;
# no es necesario definirlo manualmente ahí.
PORT=8000

# Número de workers de gunicorn. 2 es un default conservador para el
# plan gratuito/inicial de Railway; subir según CPU/RAM disponibles.
WEB_CONCURRENCY=2

# Solo para correr `python -m api.app` en desarrollo LOCAL. Nunca
# activar en producción (expone el debugger interactivo de Werkzeug).
FLASK_DEBUG=0
