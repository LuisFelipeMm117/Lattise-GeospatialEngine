# .env.example — variables de entorno para el despliegue de api/ (Stage 10).
# Copiar a .env para desarrollo local; en Railway, configurar cada una
# como variable de entorno del servicio (no subir un .env real a git).

# Orígenes permitidos para CORS, separados por coma. Sin esta variable,
# CORS queda deshabilitado (uso interno / mismo dominio / tests).
# Ejemplo para el frontend Next.js en Vercel + un entorno de preview:
ALLOWED_ORIGINS=https://lattise.io,https://www.lattise.io

# Puerto en el que escucha gunicorn/Flask. Railway lo inyecta solo;
# no es necesario definirlo manualmente ahí.
PORT=8000

# Número de workers de gunicorn. 2 es un default conservador para el
# plan gratuito/inicial de Railway; subir según CPU/RAM disponibles.
WEB_CONCURRENCY=2

# Solo para correr `python -m api.app` en desarrollo LOCAL. Nunca
# activar en producción (expone el debugger interactivo de Werkzeug).
FLASK_DEBUG=0

# Artefactos congelados del motor (R2/CDN). En producción, la imagen no
# incluye `data/` ni `serio/data/`: se descarga un ZIP versionado, validado
# por SHA-256, al volumen persistente indicado por esta ruta.
LATTISE_ARTIFACTS_DIR=/var/lib/lattise/artifacts
LATTISE_ARTIFACT_BUNDLE_URL=https://cdn.example.com/lattise-artifacts-v1.zip
LATTISE_ARTIFACT_BUNDLE_SHA256=reemplazar_con_sha256_de_64_caracteres

# ── Auth gate (Lattise Studio, app/helpers/auth_gate.py) ────────────────────
# anon/public key SOLAMENTE. El service_role key nunca va en una app
# Streamlit desplegada — solo en scripts de administración server-side
# (creación manual de usuarios invite-only).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Modo temporal de exploración sin Supabase. Mantener en `supabase` (o sin
# definir) en producción. Solo usar `disabled` en un despliegue de pruebas.
LATTISE_AUTH_MODE=supabase
# LATTISE_TEST_USER_EMAIL=tu-correo@ejemplo.com
